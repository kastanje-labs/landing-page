{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "kastanje-demo",
  "account_id": "f123845c81e006d5a9dbdbc56b543e71",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "APP_ORIGIN": "https://kastanje-app-demo.gustavonline.workers.dev"
  },
  "observability": {
    "enabled": false
  }
}
